#!/bin/bash
# macserver 더블클릭 런처 (Finder 에서 이 앱을 더블클릭하면 실행됩니다)
# 처음에는 설치 과정을 Terminal 창으로 보여주고, 이후에는 조용히 백그라운드로 실행합니다.
set -u

dialog() { # dialog "메시지" "버튼1" ["버튼2"]  → 누른 버튼 텍스트 출력
  local msg="$1"; shift
  local btns=""; for b in "$@"; do btns="$btns, \"$b\""; done; btns="${btns:2}"
  osascript 2>/dev/null <<OSA
    try
      set r to button returned of (display dialog "$msg" with title "macserver" buttons {$btns} default button 1 with icon note)
      return r
    on error
      return ""
    end try
OSA
}

# --- 프로젝트 위치 찾기 (이 앱은 macserver 폴더 안에 있어야 합니다) ---
SELF="$0"; while [ -h "$SELF" ]; do SELF="$(readlink "$SELF")"; done
EXEC_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT="$(cd "$EXEC_DIR/../../.." && pwd)"
if [ ! -f "$PROJECT/package.json" ] || ! grep -q '"macserver"' "$PROJECT/package.json" 2>/dev/null; then
  dialog "macserver 앱을 원래 폴더(macserver) 안에 둔 채로 실행해 주세요. 다른 곳으로 옮기면 실행 파일을 찾지 못해요." "확인" >/dev/null
  exit 1
fi

# --- Node 찾기 ---
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
[ -d "$HOME/.volta/bin" ] && export PATH="$HOME/.volta/bin:$PATH"
for d in "$HOME/.nvm/versions/node"/*/bin; do [ -d "$d" ] && export PATH="$d:$PATH"; done
if ! command -v node >/dev/null 2>&1; then
  r="$(dialog "macserver를 실행하려면 Node.js(20 이상)가 필요해요. nodejs.org에서 설치한 뒤 다시 더블클릭하세요." "nodejs.org 열기" "취소")"
  [ "$r" = "nodejs.org 열기" ] && open "https://nodejs.org/ko/download"
  exit 1
fi

LOGDIR="$HOME/Library/Logs"; mkdir -p "$LOGDIR"; LOG="$LOGDIR/macserver.log"
DATA="$HOME/Library/Application Support/macserver"
PORT=7777
[ -f "$DATA/settings.json" ] && PORT="$(node -e 'try{process.stdout.write(String(require(process.argv[1]).port||7777))}catch(e){process.stdout.write("7777")}' "$DATA/settings.json" 2>/dev/null || echo 7777)"

# --- 이미 실행 중이면 그 창을 앞으로 (단일 인스턴스) ---
if curl -s -m 1 "http://127.0.0.1:$PORT/api/info" >/dev/null 2>&1; then
  osascript -e 'tell application "System Events" to set frontmost of (first process whose name is "Electron" or name is "macserver") to true' >/dev/null 2>&1
  exit 0
fi

# --- 첫 실행(또는 의존성 미설치): 설치 과정을 Terminal 로 보여주며 실행 ---
if [ ! -d "$PROJECT/node_modules" ] || [ ! -d "$PROJECT/node_modules/electron" ]; then
  open -a Terminal "$PROJECT/scripts/first-run.command"
  exit 0
fi

# --- 평상시: 백그라운드로 조용히 실행 ---
echo "---- $(date) macserver 시작 ----" >> "$LOG"
cd "$PROJECT"
ELECTRON="$PROJECT/node_modules/.bin/electron"
nohup "$ELECTRON" "$PROJECT" >> "$LOG" 2>&1 &
# 서버가 뜰 때까지 최대 ~12초 대기
for i in $(seq 1 24); do
  sleep 0.5
  curl -s -m 1 "http://127.0.0.1:$PORT/api/info" >/dev/null 2>&1 && exit 0
done
# 여기까지 왔으면 뜨지 않은 것 → 로그 안내
TAIL="$(tail -n 8 "$LOG" 2>/dev/null | sed 's/"/\\"/g')"
r="$(dialog "macserver가 제대로 시작되지 않았어요. 로그를 확인해 주세요.\n\n$TAIL" "로그 열기" "닫기")"
[ "$r" = "로그 열기" ] && open "$LOG"
exit 1
